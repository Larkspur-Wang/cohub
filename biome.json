{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "files": {
    "ignore": [
      "**/.svelte-kit/**",
      "**/node_modules/**",
      "**/dist/**",
      "**/.wrangler/**"
    ]
  },
  "organizeImports": {
    "enabled": false
  },
  "formatter": {
    "enabled": false,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  }
}
