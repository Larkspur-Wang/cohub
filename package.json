{
  "name": "cohub",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:all": "node scripts/dev.mjs",
    "dev:api": "pnpm --filter @cohub/api dev",
    "dev:web": "pnpm --filter web dev",
    "dev:agent": "pnpm --filter @cohub/agent dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "typecheck": "pnpm -r typecheck",
    "format": "biome format --write .",
    "lint:biome": "biome lint .",
    "prepare": "husky",
    "ws:client": "tsx scripts/ws-client.ts",
    "test:e2e": "tsx test/e2e-test.ts",
    "test:concurrency": "tsx test/e2e-concurrency-test.ts",
    "test:stress": "tsx test/e2e-stress-test.ts",
    "test:load": "tsx test/e2e-load-test.ts",
    "test:all": "pnpm test:e2e && pnpm test:stress && pnpm test:concurrency"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "tsx": "4.21.0",
    "typescript": "6.0.3"
  }
}
