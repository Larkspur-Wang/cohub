AUTH_BASE_URL=http://talesofai-prod.talesofai-prod:8000
GITEA_BASE_URL=http://gitea-http.netaverses:3000
# Required: Gitea admin API token for managed workspace accounts
GITEA_TOKEN=xxxx
GITEA_MANAGED_EMAIL_DOMAIN=cohub.local
APP_ENCRYPTION_KEY=please-change-me-to-a-long-random-secret
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://postgres:postgres@localhost:5432/netaverses
REDIS_URL=redis://localhost:6379
# Optional: Specify kubeconfig path (defaults to ~/.kube/config)
# KUBECONFIG=/path/to/kubeconfig
# LiteLLM API key for agent sessions
LITELLM_API_KEY=sk-xxx
# Logto endpoint for token verification
LOGTO_ENDPOINT=https://dev-auth.neta.art
# Logto Management API resource indicator (default: https://default.logto.app/api)
# LOGTO_MANAGEMENT_API_RESOURCE=https://default.logto.app/api
# Logto M2M app credentials for Management API
# LOGTO_M2M_APP_ID=
# LOGTO_M2M_APP_SECRET=
# Environment: prod or dev (defaults to dev)
# ENV=prod
