{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {
      "@cohub/protocol": ["../../packages/protocol/dist/index.d.ts"],
      "@cohub/agent-sandbox-protocol": ["../../packages/agent-sandbox-protocol/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*"]
}
