{
  "name": "@cohub/agent",
  "version": "1.1.4",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "smoke:runtime": "tsx scripts/smoke-runtime.ts"
  },
  "dependencies": {
    "@cohub/core": "workspace:*",
    "@cohub/db": "workspace:*",
    "@cohub/infra": "workspace:*",
    "@cohub/protocol": "workspace:*",
    "@mariozechner/pi-agent-core": "0.70.0",
    "@mariozechner/pi-ai": "0.70.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.203.0",
    "@opentelemetry/instrumentation": "^0.215.0",
    "@opentelemetry/instrumentation-http": "^0.215.0",
    "@opentelemetry/instrumentation-ioredis": "^0.63.0",
    "@opentelemetry/resources": "^2.1.0",
    "@opentelemetry/sdk-trace-base": "^2.1.0",
    "@opentelemetry/sdk-trace-node": "^2.1.0",
    "@opentelemetry/semantic-conventions": "^1.34.0",
    "bullmq": "^5.75.2",
    "bullmq-otel": "^1.3.0",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.10.1",
    "postgres": "^3.4.9",
    "ws": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/ws": "^8.18.1",
    "@typescript/native-preview": "7.0.0-dev.20260421.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
