{
  "name": "@cohub/agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:sandbox-ws": "tsx watch src/sandbox/ws-server.ts",
    "build": "tsc",
    "lint": "biome lint src/",
    "lint:fix": "biome lint --write src/",
    "typecheck": "tsgo --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@cohub/agent-sandbox-protocol": "workspace:*",
    "@cohub/protocol": "workspace:*",
    "@mariozechner/pi-coding-agent": "0.64.0",
    "ioredis": "^5.3.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^6.0.2",
    "@typescript/native-preview": "^7.0.0-dev"
  }
}
