{
  "name": "@cohub/worker",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "typecheck": "tsgo --noEmit",
    "start": "node dist/index.js",
    "test:trigger-echo": "tsx src/test-helpers.ts trigger-echo",
    "test:trigger": "tsx src/test-helpers.ts trigger",
    "test:list-scheduled": "tsx src/test-helpers.ts list-scheduled"
  },
  "dependencies": {
    "@cohub/protocol": "workspace:*",
    "bullmq": "^5.73.4",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "ioredis": "^5.7.0",
    "postgres": "^3.4.8"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "22.10.2",
    "tsx": "4.19.2",
    "typescript": "^6.0.2",
    "@typescript/native-preview": "^7.0.0-dev"
  }
}
