{
  "name": "@cohub/worker",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "typecheck": "tsgo -p tsconfig.typecheck.json --noEmit",
    "start": "node dist/index.js",
    "test:trigger-echo": "tsx src/test-helpers.ts trigger-echo",
    "test:trigger": "tsx src/test-helpers.ts trigger",
    "test:list-scheduled": "tsx src/test-helpers.ts list-scheduled"
  },
  "dependencies": {
    "@cohub/protocol": "workspace:*",
    "bullmq": "^5.75.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.10.1",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@types/node": "25.6.0",
    "@typescript/native-preview": "7.0.0-dev.20260421.1",
    "tsx": "4.21.0",
    "typescript": "^6.0.3"
  }
}
