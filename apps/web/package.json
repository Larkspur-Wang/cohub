{
  "name": "web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "preview": "pnpm build && wrangler dev",
    "preview:prod": "pnpm build && wrangler dev --config wrangler.prod.toml",
    "deploy": "wrangler deploy",
    "deploy:prod": "wrangler deploy --config wrangler.prod.toml",
    "prepare": "svelte-kit sync || echo ''"
  },
  "dependencies": {
    "@cohub/protocol": "workspace:*",
    "@fontsource/geist": "^5.2.6",
    "@fontsource/geist-mono": "^5.2.6",
    "@logto/browser": "^3.0.12",
    "isomorphic-dompurify": "2.15.0",
    "lucide-svelte": "^1.0.1",
    "marked": "15.0.2",
    "shiki": "^4.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@sveltejs/adapter-cloudflare": "7.2.8",
    "@sveltejs/kit": "^2.50.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.1",
    "svelte": "^5.51.0",
    "svelte-check": "^4.4.2",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "wrangler": "4.70.0"
  }
}
