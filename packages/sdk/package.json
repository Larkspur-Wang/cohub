{
  "name": "@neta-art/cohub",
  "version": "1.9.0",
  "description": "Cohub SDK for spaces, sessions, checkpoints, and realtime agent collaboration.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/talesofai/cohub.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/talesofai/cohub",
  "keywords": [
    "cohub",
    "sdk",
    "ai",
    "agent",
    "spaces",
    "realtime",
    "websocket"
  ],
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./http": {
      "types": "./http.d.ts",
      "import": "./http.js"
    },
    "./websocket": {
      "types": "./websocket.d.ts",
      "import": "./websocket.js"
    }
  },
  "types": "./index.d.ts",
  "files": [
    "*.js",
    "*.d.ts",
    "chunks",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown && tsx scripts/write-publish-package.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@cohub/protocol": "workspace:*",
    "tsdown": "^0.22.0",
    "tsx": "4.21.0",
    "typescript": "^6.0.3"
  }
}
