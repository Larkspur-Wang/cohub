{
  "name": "@neta-art/cohub-board",
  "version": "0.2.0",
  "description": "Board document model, PixiJS renderers and image export for Cohub.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/talesofai/cohub.git",
    "directory": "packages/board"
  },
  "homepage": "https://github.com/talesofai/cohub",
  "keywords": [
    "cohub",
    "board",
    "whiteboard",
    "pixijs",
    "export"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./export": {
        "types": "./dist/export/index.d.ts",
        "import": "./dist/export/index.js"
      },
      "./headless": {
        "types": "./dist/export/headless.d.ts",
        "import": "./dist/export/headless.js"
      }
    },
    "types": "./dist/index.d.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./export": {
      "types": "./src/export/index.ts",
      "import": "./src/export/index.ts"
    },
    "./headless": {
      "types": "./src/export/headless.ts",
      "import": "./src/export/headless.ts"
    }
  },
  "types": "./src/index.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsdown",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --import ./scripts/register-hook.mjs --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "pixi.js": "^8.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@cohub/protocol": "workspace:*",
    "@types/node": "26.1.1",
    "tsdown": "^0.22.7",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "^1.0.2"
  }
}
