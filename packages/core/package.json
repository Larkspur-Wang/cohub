{
  "name": "@cohub/core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./permissions": {
      "types": "./dist/permissions/index.d.ts",
      "default": "./dist/permissions/index.js"
    },
    "./security": {
      "types": "./dist/security/index.d.ts",
      "default": "./dist/security/index.js"
    },
    "./security/execution-grants": {
      "types": "./dist/security/execution-grants.d.ts",
      "default": "./dist/security/execution-grants.js"
    },
    "./sessions": {
      "types": "./dist/sessions/index.d.ts",
      "default": "./dist/sessions/index.js"
    },
    "./sessions/prompt": {
      "types": "./dist/sessions/prompt.d.ts",
      "default": "./dist/sessions/prompt.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cohub/db": "workspace:*",
    "@cohub/protocol": "workspace:*",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "typescript": "^6.0.3"
  }
}
