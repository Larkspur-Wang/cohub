{
  "name": "@cohub/protocol",
  "version": "2.0.0",
  "description": "Internal shared protocol definitions for Cohub.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./model": {
      "types": "./dist/model/session.d.ts",
      "default": "./dist/model/session.js"
    },
    "./realtime": {
      "types": "./dist/realtime/index.d.ts",
      "default": "./dist/realtime/index.js"
    },
    "./gateway": {
      "types": "./dist/gateway/index.d.ts",
      "default": "./dist/gateway/index.js"
    },
    "./task": {
      "types": "./dist/task/index.d.ts",
      "default": "./dist/task/index.js"
    },
    "./fs": {
      "types": "./dist/fs/index.d.ts",
      "default": "./dist/fs/index.js"
    },
    "./ports": {
      "types": "./dist/ports/index.d.ts",
      "default": "./dist/ports/index.js"
    },
    "./generation": {
      "types": "./dist/generation/index.d.ts",
      "default": "./dist/generation/index.js"
    },
    "./platform/default-space-mods": {
      "types": "./dist/platform/default-space-mods.d.ts",
      "default": "./dist/platform/default-space-mods.js"
    },
    "./sandbox": {
      "types": "./dist/sandbox/index.d.ts",
      "default": "./dist/sandbox/index.js"
    },
    "./gateway/types": {
      "types": "./dist/gateway/types.d.ts",
      "default": "./dist/gateway/types.js"
    },
    "./realtime/types": {
      "types": "./dist/realtime/types.d.ts",
      "default": "./dist/realtime/types.js"
    },
    "./realtime/schema": {
      "types": "./dist/realtime/schema.d.ts",
      "default": "./dist/realtime/schema.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsgo -p tsconfig.build.json",
    "typecheck": "tsgo -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
